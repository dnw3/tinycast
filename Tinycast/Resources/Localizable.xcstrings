          "stringUnit": {
            "state": "translated",
            "value": "Tinycast 无法写入专用 AI 提示词。"
          }
        }
      }
    },
    "Tinycast could not write its private MCP configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
