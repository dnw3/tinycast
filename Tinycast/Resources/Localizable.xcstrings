          "stringUnit": {
            "state": "translated",
            "value": "Tinycast 需要辅助功能权限"
          }
        }
      }
    },
    "Tinycast Settings": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast 设置"
          }
        }
      }
    },
    "Tinycast always tells the model to return only the transformed text, and to treat your selection as material rather than as instructions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast 始终要求模型只返回处理后的文本，并将选中文本视为待处理材料，而不是指令。"
          }
        }
      }
    },
    "Tinycast can index every folder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast 可以索引所有文件夹。"
          }
        }
      }
    },
    "Tinycast can’t uninstall this app.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast 无法卸载此应用。"
          }
        }
      }
    },
    "Tinycast could not be replaced. %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法替换 Tinycast。%@"
          }
        }
      }
